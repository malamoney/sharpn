# Editor state, not project configuration.
.vscode/

# Installed from package-lock.json, which is committed.
node_modules/

# Build output. The generated protobuf bindings are *not* here: they are
# committed, so that no image build needs protoc. See buf.gen.yaml.
dist/
*.tsbuildinfo

# Where scripts/generate-openapi.sh compiles to. Inside the repository because
# the compiled code has to be able to resolve node_modules/, and removed again
# when the script exits.
.openapi.*

# This Mac's own deploy: the compose secrets and the TLS material mkcert
# writes, plus the `.env` they and the Gateway's address are read from. None
# of it is fit to commit — see docs/deployment.md for what goes in each file.
secrets/*
!secrets/.gitkeep
certs/*
!certs/.gitkeep
.env

# The e2e Compose stack's own secrets and certificates, freshly minted per
# checkout by scripts/e2e-secrets.sh — see docker-compose.e2e.yml.
.e2e/

# Where playwright test writes its own report and traces.
apps/e2e/playwright-report/
apps/e2e/test-results/
