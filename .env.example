# Copy to `.env` (untracked; see .gitignore) and fill in for this Mac and this
# Gateway. `docker compose` reads `.env` on its own — nothing here needs to be
# exported by hand.

# The Gateway's LAN name and port (config.ts's GATEWAY_TARGET, ADR 0003) and
# the LAN IP that name is mapped to in the console-api container, since its
# resolver has no mDNS (ADR 0004, docker-compose.yml's `extra_hosts`). Give
# the certificate in ./secrets/gateway-certificate a Subject Alternative Name
# matching GATEWAY_HOSTNAME, or the Console API will refuse to connect to it.
GATEWAY_HOSTNAME=gateway.sharpn.internal
GATEWAY_PORT=50051
GATEWAY_HOST_IP=192.168.1.50

# Stamped into both images as a label and, for the Console API, as the
# `/version` route's answer. Left unset, an image reports "unknown" for
# either, which is a true answer and not a good one to see on a deploy meant
# to be a release. `scripts/deploy.sh` derives both and exports them before
# calling `docker compose up --build`, so most of the time nothing here needs
# setting by hand.
GIT_SHA=
PROTO_REVISION=
